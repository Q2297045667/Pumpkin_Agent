# shellcheck shell=bash
# SPDX-License-Identifier: GPL-3.0-only
# Adapted from https://github.com/Q2297045667/PumpGsit/tree/e061ad93b8638b000ebea8f434a4786621dbcc41/.github
# The template generalizes the plugin name, Cargo target and component checks.

# 在目标插件仓库的这份文件中填写构建配置。
# 发布文件名（省略 .wasm 后缀），同时用作默认的 Pumpkin Market 条目名称。
PLUGIN_NAME=ExamplePlugin
# 插件的 Cargo 包名，对应 Cargo.toml 的 [package].name。工作区项目填写插件所在的包。
CARGO_PACKAGE=example-plugin
# 商店条目的显示名称与 PLUGIN_NAME 不同时，取消下一行注释并填写完整名称。
# MARKET_PLUGIN_NAME='Example Plugin'

# GitHub Actions 仓库设置（仅在手动运行 Releases 并勾选上传 Pumpkin Market 时需要）
# 在目标插件的 GitHub 仓库打开 Settings → Secrets and variables → Actions。
# 1. 在 Variables → New repository variable 中，Name 填 PUMPKIN_MARKET_PLUGIN_ID，
#    Value 填商店后台该插件管理页面地址中的数字 ID，例如 12345，点击 Add variable。
# 2. 在 Secrets → New repository secret 中，Name 填 PUMPKIN_MARKET_TOKEN，
#    Secret 填商店令牌，点击 Add secret。真实令牌只保存在 GitHub 的 Secret 中。
# 构建检查、Nightly 和仅发布到 GitHub 的正式版均可跳过以上两项。

if [[ ! $PLUGIN_NAME =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
    echo 'PLUGIN_NAME must be a filename stem using ASCII letters, digits, dots, underscores or hyphens, starting with a letter or digit.' >&2
    return 1
fi
